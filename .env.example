# Production runner RPCs. Configure at least two independently operated,
# credentialed Base providers; public defaults are rate-limited fallbacks only.
BASE_RPC_URL=

# Comma-separated independent fallbacks used for block/state quorum checks.
BASE_RPC_URLS=
BASE_LOG_RPC_URLS=
BASE_RPC_QUORUM_SIZE=2
# Publish from a hash-agreed block just behind the quorum head.
BASE_SNAPSHOT_CONFIRMATIONS=1
# Bound one slow provider without weakening the independent quorum.
BASE_RPC_QUORUM_DEADLINE_SECONDS=35
BASE_RPC_HEAD_PROBE_DEADLINE_SECONDS=12
BASE_RPC_HEAD_PROBE_GRACE_SECONDS=0.35
BASE_RPC_SLOW_COOLDOWN_SECONDS=60

# Optional log fetch tuning.
BASE_FROM_BLOCK=40500000
BASE_LOG_CHUNK=2000
BASE_LOG_WORKERS=4
BASE_RPC_ATTEMPTS=6
BASE_RPC_BATCH_LIMIT=10
DOG_METADATA_WORKERS=16
MISSION3_LOG_CACHE=1
MISSION3_LOG_CACHE_OVERLAP_BLOCKS=100
# Cross-check recent event windows with the provider quorum.
# Public fallbacks accept a small recent window; credentialed providers may
# raise this after a startup capability probe.
MISSION3_LOG_QUORUM_MAX_BLOCKS=50
# Split bounded recent windows into quorum-checked chunks up to this total span.
MISSION3_LOG_QUORUM_WINDOW_BLOCKS=500
MISSION3_CURRENT_SURFACE_OVERLAP=100
MISSION3_BALANCE_CACHE=1

# Optional identity and price context. Never commit real keys or secrets.
NEYNAR_API_KEY=
WOOF_USD_PRICE=
SUP_USD_PRICE=


# Optional archive/API keys for recovery work. Keep real values local only.
COINGECKO_API_KEY=
# Default off: prefer DefiLlama first to avoid public CoinGecko 429s on scheduled refreshes.
HISTORICAL_PRICES_PREFER_COINGECKO=0
DUNE_API_KEY=

# Optional mission archive tuning.
MISSION2_LOG_CHUNK=5000
MISSION3_LOG_CHUNK=10000
MISSION3_LOG_WORKERS=4

# Optional precise onchain activity watcher.
# The hourly refresh remains the baseline; the watcher triggers extra refreshes only on real auction-house changes.
MISSION3_WATCHER_INTERVAL_SECONDS=30
MISSION3_WATCHER_COOLDOWN_SECONDS=30
MISSION3_WATCHER_BID_COOLDOWN_SECONDS=30
# Disabled by default to avoid duplicate hourly full refreshes when launchd hourly refresh is installed.
MISSION3_WATCHER_FORCE_REFRESH_AFTER_SECONDS=0
MISSION3_WATCHER_LOOKBACK_BLOCKS=100
MISSION3_WATCHER_SAFETY_OVERLAP_BLOCKS=50
MISSION3_WATCHER_LOG_CHUNK=50
MISSION3_WATCHER_STATE_PATH=.local/mission3_onchain_tracker_state.json
MISSION3_WATCHER_LOCK_PATH=.local/mission3_onchain_tracker.lock
# Leave blank so launchd installs default to $DEGEN_DOGS_LOG_DIR/watch-onchain.log.
# Set only for explicit local-file overrides, or '-' for stdout-only dry runs.
MISSION3_WATCHER_LOG_PATH=
# Shared with scripts/refresh_and_publish.sh so hourly and event refreshes cannot overlap.
MISSION3_REFRESH_LOCK_PATH=~/Library/Caches/degen-dogs-mission3/refresh.lock
# Leave blank to let installers select refresh:current (local) or
# refresh:publish (explicit auto-push mode).
MISSION3_REFRESH_COMMAND=
MISSION3_WATCHER_AUTO_PUSH=0
# Defaults on only when MISSION3_WATCHER_AUTO_PUSH=1. Set explicitly for stricter local refreshes.
MISSION3_WATCHER_REQUIRE_CLEAN_TREE=0
MISSION3_WATCHER_REFRESH_TIMEOUT_SECONDS=1800
