# Copy to .env.local in the WSL ext4 clone, fill the credentialed endpoints,
# then chmod 600. This file is documentation only and contains no secrets.

# Use at least two independently operated, credentialed, archive-capable Base
# providers in each list. Three operators are preferable for 2-of-3 failover.
BASE_RPC_URLS=
BASE_LOG_RPC_URLS=
BASE_INCLUDE_PUBLIC_FALLBACKS=0
BASE_RPC_QUORUM_SIZE=2

# Accuracy and bounded concurrency. These defaults match the verified pipeline;
# increase provider quotas before raising worker counts.
BASE_SNAPSHOT_CONFIRMATIONS=1
BASE_RPC_MAX_HEAD_SPREAD_BLOCKS=20
BASE_RPC_MAX_BLOCK_AGE_SECONDS=600
BASE_LOG_CHUNK=2000
BASE_LOG_WORKERS=4
BASE_RPC_ATTEMPTS=6
BASE_RPC_BATCH_LIMIT=10
BASE_TOKEN_URI_CHUNK_DELAY_SECONDS=1.0
DOG_METADATA_WORKERS=16
MISSION3_LOG_CACHE=1
MISSION3_LOG_CACHE_OVERLAP_BLOCKS=100

# Public-safe identity used in local telemetry and commit metadata. Never put a
# host name, Windows account name, serial number, or secret in this field.
DEGEN_DOGS_RUNNER_ID=windows-wsl

# Git/publish policy. The launcher unconditionally pins remote=origin,
# branch=main, skip-push=0, and skip-pull=0 after loading this file; the values
# below document that non-overridable deployment policy. Event jobs are bounded
# with archive work disabled; hourly jobs include incremental archive work.
DEGEN_DOGS_REMOTE=origin
DEGEN_DOGS_BRANCH=main
DEGEN_DOGS_COMMIT_PREFIX=[pc-runner]
DEGEN_DOGS_SKIP_PUSH=0
DEGEN_DOGS_SKIP_PULL=0
DEGEN_DOGS_LIVE_VERIFY_AFTER_PUSH=1
DEGEN_DOGS_LIVE_VERIFY_TIMEOUT_SECONDS=900
DEGEN_DOGS_LIVE_VERIFY_INTERVAL_SECONDS=15
DEGEN_DOGS_GIT_RETRY_ATTEMPTS=4
DEGEN_DOGS_GIT_RETRY_BASE_SECONDS=2
DEGEN_DOGS_GIT_RETRY_MAX_SECONDS=30
DEGEN_DOGS_GIT_RETRY_JITTER_SECONDS=5

# Watcher policy. The WSL timer samples at seconds 07/22/37/52 to complement
# the peer runner and the local shared fcntl lock prevents PC-local overlap.
MISSION3_WATCHER_INTERVAL_SECONDS=15
MISSION3_WATCHER_COOLDOWN_SECONDS=30
MISSION3_WATCHER_BID_COOLDOWN_SECONDS=15
MISSION3_WATCHER_LOOKBACK_BLOCKS=100
MISSION3_WATCHER_SAFETY_OVERLAP_BLOCKS=50
MISSION3_WATCHER_LOG_CHUNK=2000
MISSION3_WATCHER_REFRESH_TIMEOUT_SECONDS=1800

# WSL health thresholds.
DEGEN_DOGS_HEALTH_WATCHER_STALE_SECONDS=180
DEGEN_DOGS_HEALTH_PENDING_STALE_SECONDS=900
DEGEN_DOGS_HEALTH_LIVE_STALE_SECONDS=5400
DEGEN_DOGS_HEALTH_REMOTE_TIMEOUT_SECONDS=15
DEGEN_DOGS_HEALTH_MIN_FREE_BYTES=5368709120
DEGEN_DOGS_HEALTH_MIN_FREE_PERCENT=5
