[Unit]
Description=Verify Degen Dogs WSL runner, Git state, disk, and live freshness
Wants=network-online.target
After=network-online.target
ConditionPathExists=/run/degen-dogs/activation-enabled
# The timer is the sole retry owner. Successful probes and temporary outages
# must never consume a rate-limit bucket that suppresses later health checks.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=@RUNNER_USER@
Group=@RUNNER_GROUP@
WorkingDirectory=@REPO_DIR@
UMask=0077
Environment=HOME=@RUNNER_HOME@
Environment=DEGEN_DOGS_REPO_DIR=@REPO_DIR@
Environment=DEGEN_DOGS_LOG_DIR=@LOG_DIR@
Environment=DEGEN_DOGS_LOCK_DIR=@LOCK_DIR@
Environment=DEGEN_DOGS_ENV_FILE=@ENV_FILE@
Environment=DEGEN_DOGS_RUNNER_ID=@RUNNER_ID@
ExecStartPre=+/usr/local/libexec/degen-dogs-wsl-health-state begin-health
ExecStart=/bin/bash -p @REPO_DIR@/scripts/run_wsl_runner_job.sh health
ExecStopPost=+/usr/local/libexec/degen-dogs-wsl-health-state record-health
TimeoutStartSec=90s
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@REPO_DIR@ @LOG_DIR@ @LOCK_DIR@ /run/degen-dogs/health /var/lib/degen-dogs/health
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
StandardOutput=journal
StandardError=journal
