[Unit]
Description=Retry the Degen Dogs WSL health probe one minute after completion

[Timer]
OnBootSec=2min
# Always establish a future deadline when this timer is restarted after boot.
OnActiveSec=1min
OnUnitInactiveSec=1min
AccuracySec=15s
RandomizedDelaySec=15s
Persistent=true
Unit=degen-dogs-health.service

[Install]
WantedBy=timers.target
