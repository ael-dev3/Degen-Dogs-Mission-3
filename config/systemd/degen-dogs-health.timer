[Unit]
Description=Run the Degen Dogs WSL health probe every five minutes

[Timer]
OnBootSec=2min
# Always establish a future deadline when this timer is restarted after boot.
OnActiveSec=5min
OnUnitInactiveSec=5min
AccuracySec=15s
RandomizedDelaySec=15s
Persistent=true
Unit=degen-dogs-health.service

[Install]
WantedBy=timers.target
